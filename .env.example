# ===== QQ 开放平台 =====
QQ_APPID=1905292051
QQ_SECRET=你的 AppSecret

# ===== OpenClaw 网关（本地，别暴露到公网）=====
OPENCLAW_BASE=http://localhost:18789
OPENCLAW_TOKEN=网关 token
OPENCLAW_MODEL=openclaw/default

# ===== 学校网关 ECUST（可选；给 /models /model /raw 的裸模型命令用）=====
ECUST_BASE_URL=https://ai.ecustcic.com/api/v1
ECUST_API_KEY=你的 ECUST API Key
ECUST_MODEL=deepseek-v4.1-flash
# 可选：普拉娜的人设（system prompt），留空 = 不加
ECUST_SYSTEM_PROMPT=

# ===== 可选：管理员白名单（留空 = 所有人都能跟 agent 说话）=====
ADMIN_OPENID=

# ===== 数据目录（token 缓存、日志）=====
DATA_DIR=./data

# ===== 可选：消息处理调优 =====
# 同时在处理的消息数上限（不同人可并行；同一个人仍按顺序）
MAX_CONCURRENT=8
# 超过这么多秒还没算完，就先回一句 ACK_TEXT（QQ 被动回复用 msg_seq 续）
ACK_AFTER=2.5
ACK_TEXT=（在想…）
# 非管理员能用哪些命令（其余仅管理员）
PUBLIC_COMMANDS=help,test502,time,raw,forget
# /raw 防刷：非管理员每人每 RAW_RATE_WINDOW 秒最多 RAW_RATE_LIMIT 次（0 = 不限）
RAW_RATE_LIMIT=3
RAW_RATE_WINDOW=60
