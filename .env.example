# ===== QQ 开放平台 =====
QQ_APPID=1905292051
QQ_SECRET=你的 AppSecret

# ===== OpenClaw 网关（本地，别暴露到公网）=====
OPENCLAW_BASE=http://localhost:18789
OPENCLAW_TOKEN=网关 token
OPENCLAW_MODEL=openclaw/default

# ===== 学校网关 ECUST（可选；给 /models /model /raw 的裸模型命令用）=====
ECUST_BASE_URL=https://ai.ecustcic.com/api/v1
ECUST_API_KEY=你的 ECUST API Key
ECUST_MODEL=deepseek-v4.1-flash
# 可选：普拉娜的人设（system prompt），留空 = 不加
ECUST_SYSTEM_PROMPT=

# ===== 可选：管理员白名单（留空 = 所有人都能跟 agent 说话）=====
ADMIN_OPENID=

# ===== 数据目录（token 缓存、日志）=====
DATA_DIR=./data

# ===== 可选：消息处理调优 =====
# 同时在处理的消息数上限（不同人可并行；同一个人仍按顺序）
MAX_CONCURRENT=8
# 超过这么多秒还没算完，就先回一句 ACK_TEXT（QQ 被动回复用 msg_seq 续）
ACK_AFTER=2.5
ACK_TEXT=（在想…）
# 非管理员能用哪些命令（其余仅管理员）
PUBLIC_COMMANDS=help,test502,time,raw,forget
# /raw 防刷：非管理员每人每 RAW_RATE_WINDOW 秒最多 RAW_RATE_LIMIT 次（0 = 不限）
RAW_RATE_LIMIT=3
RAW_RATE_WINDOW=60

# ===== 可选：群复读 =====
# 连续多少条相同文本才复读（且至少 2 个不同的人；一个人单刷不算）
REPEAT_MIN_COUNT=3
# 攒够条数后再等多少秒才复读（期间话题变了就不复读了）
REPEAT_DELAY=30

# ===== 可选：B站分享识别 =====
# 总闸（0/false/off = 全关）
BILI_ENABLE=1
# 名单模式：black = 默认开、名单里的群关；white = 默认关、名单里的群开
BILI_MODE=black
# 黑名单初值（逗号分隔的群 openid）
BILI_OFF_GROUPS=
# 白名单初值（逗号分隔的群 openid）
BILI_ONLY_GROUPS=
# 输出方式：0 = 发纯文本（BV号单独一行，可复制）；1 = 发图文卡片（点进去是小程序）
BILI_CARD=0
# 回复里是否附带完整 URL：0 = 不带（QQ 会把链接渲染成小程序预览）；1 = 带
BILI_LINK=0

# ===== 可选：群里不 @ 机器人也能用的命令 =====
# 总闸：0 = 群里不 @ 机器人就不响应斜杠命令（只能 @ 机器人用）
#     1 = 允许（管理员响应所有命令，其他人只响应下面列的公开命令）
GROUP_COMMAND_ENABLE=1
# 其他人在群里能用的公开命令（管理员不受这个限制）
GROUP_COMMANDS=help,time,choose,echo,whoami
